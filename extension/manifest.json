{
  "manifest_version": 3,
  "name": "QA Bug Recorder",
  "short_name": "QA Bug",
  "description": "Фиксация багов: пометки и выбор элемента на странице, видео, голос, логи консоли, запросы и действия. Экспорт в Word, Markdown, HTML, HAR.",
  "version": "1.5.1",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "tabCapture",
    "offscreen",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "QA Bug Recorder",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "inject.js",
        "probe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "found-bug": {
      "suggested_key": {
        "default": "Ctrl+Shift+Q",
        "mac": "MacCtrl+Shift+Q"
      },
      "description": "Начать проверку / открыть панель"
    },
    "pick-element": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Выбрать элемент для замечания"
    },
    "annotate": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Нарисовать стрелку"
    },
    "finish": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Завершить проверку и открыть отчёт"
    }
  }
}