{
  "manifest_version": 3,
  "name": "QA Bug Recorder",
  "short_name": "QA Bug",
  "description": "__MSG_desc__",
  "version": "2.6.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "tabCapture",
    "offscreen",
    "identity",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_title__",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "inject.js",
        "probe.js",
        "rr.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "found-bug": {
      "suggested_key": {
        "default": "Ctrl+Shift+Q",
        "mac": "MacCtrl+Shift+Q"
      },
      "description": "__MSG_cmd_found__"
    },
    "pick-element": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "__MSG_cmd_pick__"
    },
    "annotate": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "__MSG_cmd_arrow__"
    },
    "finish": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_cmd_finish__"
    },
    "design": {
      "description": "__MSG_cmd_design__"
    }
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "default_locale": "en"
}
